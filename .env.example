# Eigenes, langes Passwort fuer die Datenbank (nur intern im Docker-Netz verwendet).
DB_PASSWORD=

# Zeitzone des Servers
TZ=Europe/Berlin

# Wie das Panel nach aussen kommt (install.sh setzt das automatisch):
#   eigener Caddy auf Port 80/443 mit automatischem HTTPS:
COMPOSE_FILE=docker-compose.yml:compose.caddy.yml
